<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Filee.App.ViewModels"
        x:Class="Filee.App.Views.ValuePromptWindow"
        x:DataType="vm:ValuePromptViewModel"
        Title="{Binding Title}"
        Icon="avares://Filee/Assets/Icons/filee.ico"
        Width="440" SizeToContent="Height" MinWidth="380"
        WindowStartupLocation="CenterScreen"
        CanResize="False">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Padding="20,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SubtleBorderBrush}"
            Background="{DynamicResource SurfaceBrush}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button x:Name="CancelBtn" Content="{DynamicResource common.cancel}" Click="OnCancel" IsCancel="True" />
        <Button x:Name="OkBtn" Classes="accent" Content="{DynamicResource common.ok}" Click="OnOk" IsDefault="True" IsEnabled="{Binding IsValid}" />
      </StackPanel>
    </Border>

    <StackPanel Margin="20,18,20,16" Spacing="14">
      <TextBlock Classes="h2" Text="{Binding Title}" />

      <!-- Target Size UI -->
      <StackPanel Spacing="10" IsVisible="{Binding IsTargetSize}">
        <TextBlock Classes="caption" Text="{Binding CurrentSizeText}"
                   IsVisible="{Binding CurrentSizeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox x:Name="TargetSizeInput" Text="{Binding TargetSizeText}" Width="200" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit}" Width="80" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>

      <!-- Pixels UI -->
      <StackPanel Spacing="10" IsVisible="{Binding IsPixels}">
        <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Classes="caption" Text="Width" />
          <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding WidthText}" />
          <TextBlock Grid.Row="0" Grid.Column="2" Classes="caption" Text="Height" />
          <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding HeightText}" />
        </Grid>
        <CheckBox Content="Keep aspect ratio" IsChecked="{Binding KeepAspect}" />
      </StackPanel>

      <!-- Percent UI -->
      <StackPanel Spacing="10" IsVisible="{Binding IsPercent}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Text="{Binding PercentText}" Width="120" />
          <TextBlock Text="%" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>

      <!-- Quality UI -->
      <StackPanel Spacing="10" IsVisible="{Binding IsQuality}">
        <Grid ColumnDefinitions="*,12,50">
          <Slider Grid.Column="0" Minimum="1" Maximum="100" Value="{Binding QualityValue}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding QualityValue}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
      </StackPanel>

      <!-- Dpi UI -->
      <StackPanel Spacing="10" IsVisible="{Binding IsDpi}">
        <TextBox Text="{Binding DpiText}" Width="120" HorizontalAlignment="Left" />
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Classes="ghost" Content="72" Command="{Binding SetDpiCommand}" CommandParameter="72" />
          <Button Classes="ghost" Content="96" Command="{Binding SetDpiCommand}" CommandParameter="96" />
          <Button Classes="ghost" Content="150" Command="{Binding SetDpiCommand}" CommandParameter="150" />
          <Button Classes="ghost" Content="300" Command="{Binding SetDpiCommand}" CommandParameter="300" />
        </StackPanel>
      </StackPanel>

      <!-- Inline Error -->
      <TextBlock Classes="caption danger" TextWrapping="Wrap" Text="{Binding Error}"
                 IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
  </DockPanel>
</Window>
